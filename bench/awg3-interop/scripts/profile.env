# Topology only. Protocol parameters live in profiles.sh, keyed by version, so
# there is exactly one place where a scenario's obfuscation is defined.

# Tunnel addressing
SRV_TUN=10.55.0.1
CLI_TUN=10.55.0.2
TUN_MASK=24

# Underlay addressing (docker network awg3net). The first two octets follow
# whatever network run.sh created (AWG3_NET), read off this container's own
# address, so the two files cannot disagree.
NET4=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d. -f1-2)
[ -n "$NET4" ] || NET4=172.30
SRV_IP=$NET4.0.10
PRX_IP=$NET4.0.20
CLI_IP=$NET4.0.30
SRV_PORT=51820
PRX_PORT=51820
CLI_PORT=51821

# IPv6 underlay. Only the proxy->server leg ever uses it: the client always
# reaches the proxy over IPv4, exactly as on a MikroTik where that hop is a
# local veth. SRV_HOST is the container name, which Docker's embedded DNS
# answers with both an A and an AAAA record -- the dual-stack case the Happy
# Eyeballs probe exists for.
SRV_IP6=fd00:30::10
PRX_IP6=fd00:30::20
CLI_IP6=fd00:30::30
SRV_HOST=awg3-server
